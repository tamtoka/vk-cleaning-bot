# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в git и не должен публиковаться.

# Ключ доступа сообщества ВКонтакте.
# Вставьте его после знака "=" без кавычек и пробелов.
VK_TOKEN=

# Контакт менеджера: телефон, ссылка на страницу ВК или email.
# Можно оставить пустым — бот запустится, но кнопка связи сообщит,
# что контакт пока не указан.
MANAGER_CONTACT=
